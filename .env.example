# Copy to .env, or run `bash scripts/dev-up.sh`, which creates .env from this
# file with random secrets and starts the stack.
#
# Inside docker compose, the host names below are overridden per service
# (kafka:29092, clickhouse, postgres, redis); these values are for running a
# service directly on your machine.
POSTGRES_DSN=postgresql://opentelm:opentelm@localhost:5432/opentelm
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=opentelm
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=llm.requests
REDIS_URL=redis://localhost:6379/0

# Ingest API
INGEST_API_PORT=8000

# Auth Service
AUTH_SERVICE_PORT=8001

# ---- Secrets: REQUIRED, no defaults ----------------------------------------
# Services refuse to start if these are empty, too short, or one of the old
# published placeholders. dev-up.sh fills them in. By hand:
#   openssl rand -hex 32
#
# Signs login tokens. Shared by auth-service and the dashboard. 32+ chars.
JWT_SECRET_KEY=
# HMAC pepper for API-key hashes. Shared by auth-service and ingest-api.
# 16+ chars. Changing it invalidates every existing API key.
API_KEY_PEPPER=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# How long the apikey:{hash} cache lives in Redis (seconds). 24h.
APIKEY_CACHE_TTL_S=86400

# Dashboard
NEXT_PUBLIC_APP_NAME=OpenTelLM

# Optional: correct or add model prices without a code change
# (USD per 1M tokens, [input, output]). See consumer/pricing.py.
# PRICING_OVERRIDES={"my-finetune": [0.5, 1.5]}
