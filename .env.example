# Copy to .env and fill in values
POSTGRES_DSN=postgresql://opentelm:opentelm@localhost:5432/opentelm
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=opentelm
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=llm.requests
REDIS_URL=redis://localhost:6379/0

# Ingest API
INGEST_API_PORT=8000

# Auth Service
AUTH_SERVICE_PORT=8001

# JWT — MUST be at least 32 chars in production. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-must-be-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API key HMAC pepper. MUST match across auth-service and ingest-api so hashes
# are interchangeable. Rotating this invalidates every existing API key.
API_KEY_PEPPER=opentelm-key-secret

# How long the apikey:{hash} cache lives in Redis (seconds). 24h.
APIKEY_CACHE_TTL_S=86400

# Dashboard
NEXT_PUBLIC_APP_NAME=OpenTelLM
# Cookie signing secret. Generate with: openssl rand -hex 16
COOKIE_SECRET=change-me-32-chars-of-random-data
