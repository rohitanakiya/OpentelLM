# Template only — DO NOT COMMIT FILLED-IN VALUES.
#
# The recommended pattern is to NOT use this file at all in production:
#   - Store every secret in GCP Secret Manager (Terraform already creates
#     opentelm-postgres-dsn and opentelm-redis-url for you).
#   - Use the External Secrets operator (or `kubectl create secret` from a
#     helper script) to materialise them as the K8s Secret below.
#
# For an interview/demo, the simplest reproducible workflow is:
#
#   cp secrets.yaml.example secrets.yaml
#   # edit values
#   kubectl apply -f secrets.yaml
#   git restore secrets.yaml   # or just rm — never commit it.
#
# secrets.yaml is in .gitignore.

apiVersion: v1
kind: Secret
metadata:
  name: opentelm-secrets
  namespace: opentelm
type: Opaque
stringData:
  # ---- Cross-service shared secrets (must match in every pod) ----
  JWT_SECRET_KEY:    "REPLACE_ME_at_least_32_chars_random"
  COOKIE_SECRET:     "REPLACE_ME_32_chars_of_random_data"
  API_KEY_PEPPER:    "REPLACE_ME_HMAC_pepper_for_api_keys"

  # ---- Postgres (from Terraform secret opentelm-postgres-dsn) ----
  POSTGRES_DSN:      "postgresql://opentelm:PASSWORD@PRIVATE_IP:5432/opentelm"

  # ---- Redis (from Terraform secret opentelm-redis-url) ----
  REDIS_URL:         "redis://:AUTH_STRING@HOST:6379"

  # ---- ClickHouse Cloud ----
  CLICKHOUSE_URL:      "https://your-instance.clickhouse.cloud:8443"
  CLICKHOUSE_HOST:     "your-instance.clickhouse.cloud"
  CLICKHOUSE_PORT:     "9440"
  CLICKHOUSE_USER:     "default"
  CLICKHOUSE_PASSWORD: "REPLACE_ME"

  # ---- Confluent Cloud Kafka ----
  KAFKA_BOOTSTRAP_SERVERS: "pkc-XXXXX.confluent.cloud:9092"
  CONFLUENT_API_KEY:       "REPLACE_ME"
  CONFLUENT_API_SECRET:    "REPLACE_ME"
